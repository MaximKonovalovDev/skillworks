{
  "about": "Every pair is run by tests/test_pwsh_for_bash_writers.py in pwsh 7 with Git's usr/bin removed from PATH (the failing setup). bad must fail or give a wrong answer; good must print the expected text. Edit this file, then run: python skills/pwsh-for-bash-writers/scripts/pairs_to_md.py",
  "fixture": {
    "notes.txt": "alpha 1\nbeta 2\nTODO gamma 3\ndelta 4\nTODO epsilon 5\n",
    "other.txt": "alpha 1\nbeta 9\n",
    "sub/a.md": "# A\nTODO one\n",
    "sub/b.md": "# B\nnothing\n",
    "sub/[x]/g.txt": "hi\n",
    "my tools/hello.cmd": "@echo hello from tools\r\n"
  },
  "pairs": [
    {"id": "grep-line", "group": "search", "bad": "grep -n TODO notes.txt", "good": "Select-String -Path notes.txt -Pattern TODO", "expect": "notes.txt:3:TODO gamma 3", "bad_error": "not recognized", "note": "Or use the Grep tool. rg (ripgrep) is installed too: rg -n TODO notes.txt."},
    {"id": "rg-search", "group": "search", "good": "rg -n TODO notes.txt", "expect": "3:TODO gamma 3", "note": "ripgrep is installed and fast. Put the pattern in single quotes: rg -n 'a|b' path. Select-String takes a regex too; add -SimpleMatch for plain text."},
    {"id": "grep-count", "group": "search", "bad": "grep -c TODO notes.txt", "good": "(Select-String -Path notes.txt -Pattern TODO).Count", "expect": "2", "bad_error": "not recognized"},
    {"id": "grep-files", "group": "search", "bad": "grep -rl TODO sub", "good": "Select-String -Path sub/*.md -Pattern TODO -List | ForEach-Object Path", "expect": "a.md", "bad_error": "not recognized", "note": "Select-String expands the wildcard itself; for a whole tree pipe Get-ChildItem -Recurse -Filter *.md into it."},
    {"id": "grep-head-pipe", "group": "search", "bad": "Get-Content notes.txt | grep TODO | head -n 1", "good": "Get-Content notes.txt | Select-String TODO | Select-Object -First 1", "expect": "TODO gamma 3", "bad_error": "not recognized"},
    {"id": "head", "group": "slice", "bad": "head -n 2 notes.txt", "good": "Get-Content notes.txt -TotalCount 2", "expect": "beta 2", "bad_error": "not recognized"},
    {"id": "tail", "group": "slice", "bad": "tail -n 2 notes.txt", "good": "Get-Content notes.txt -Tail 2", "expect": "TODO epsilon 5", "bad_error": "not recognized"},
    {"id": "head-bytes", "group": "slice", "bad": "node -e 'console.log(\"x\".repeat(50))' | head -c 10", "good": "node -e 'console.log(\"x\".repeat(50))' | ForEach-Object { $_.Substring(0, [Math]::Min(10, $_.Length)) }", "expect": "xxxxxxxxxx", "bad_error": "not recognized"},
    {"id": "wc-lines", "group": "slice", "bad": "wc -l notes.txt", "good": "@(Get-Content notes.txt).Count", "expect": "5", "bad_error": "not recognized"},
    {"id": "sed-range", "group": "slice", "bad": "sed -n '2,3p' notes.txt", "good": "Get-Content notes.txt | Select-Object -Skip 1 -First 2", "expect": "TODO gamma 3", "bad_error": "not recognized", "note": "Or use the Read tool with offset and limit."},
    {"id": "sed-replace", "group": "slice", "bad": "sed 's/TODO/DONE/' notes.txt", "good": "(Get-Content notes.txt) -replace 'TODO','DONE'", "expect": "DONE gamma 3", "bad_error": "not recognized", "note": "To change a file use the Edit tool, not sed -i."},
    {"id": "awk-column", "group": "slice", "bad": "awk '{print $2}' notes.txt", "good": "Get-Content notes.txt | ForEach-Object { ($_ -split '\\s+')[1] }", "expect": "gamma", "bad_error": "not recognized"},
    {"id": "sort-uniq", "group": "slice", "bad": "Get-Content notes.txt | ForEach-Object { $_.Split(' ')[0] } | sort | uniq -c", "good": "Get-Content notes.txt | ForEach-Object { $_.Split(' ')[0] } | Group-Object | Sort-Object Count -Descending | Select-Object -First 1 Name,Count", "expect": "TODO", "bad_error": "not recognized"},
    {"id": "find-name", "group": "files", "bad": "find . -name '*.md'", "good": "Get-ChildItem -Recurse -Filter *.md | ForEach-Object Name", "expect": "a.md", "bad_error": "File not found", "note": "find is the old Windows find.exe, not the Unix one. Or use the Glob tool."},
    {"id": "which", "group": "files", "bad": "which node", "good": "(Get-Command node).Source", "expect": "node", "bad_error": "not recognized"},
    {"id": "ls-flags", "group": "files", "bad": "ls -la", "good": "Get-ChildItem -Force | ForEach-Object Name", "expect": "notes.txt", "bad_error": "parameter", "note": "ls is an alias of Get-ChildItem: plain ls works, ls -la does not."},
    {"id": "touch", "group": "files", "bad": "touch x.txt", "good": "if (-not (Test-Path x.txt)) { New-Item -ItemType File x.txt | Out-Null }; Test-Path x.txt", "expect": "True", "bad_error": "not recognized"},
    {"id": "rm-rf", "group": "files", "bad": "New-Item -ItemType Directory sub2 | Out-Null; rm -rf sub2", "good": "New-Item -ItemType Directory sub2 | Out-Null; Remove-Item -Recurse -Force sub2; Test-Path sub2", "expect": "False", "bad_error": "parameter"},
    {"id": "test-file", "group": "files", "bad": "[ -f notes.txt ] && echo yes", "good": "Test-Path -LiteralPath notes.txt -PathType Leaf", "expect": "True", "bad_error": "Missing type name"},
    {"id": "basename", "group": "files", "bad": "basename sub/a.md", "good": "Split-Path sub/a.md -Leaf", "expect": "a.md", "bad_error": "not recognized"},
    {"id": "diff-files", "group": "files", "bad": "diff notes.txt other.txt", "good": "Compare-Object (Get-Content notes.txt) (Get-Content other.txt)", "expect": "beta 9", "bad_silent": true, "note": "diff is an alias of Compare-Object: it compares the two names, not the file contents, and prints nothing useful."},
    {"id": "date-utc", "group": "time", "bad": "date -u +%Y-%m-%dT%H:%MZ", "good": "Get-Date -AsUTC -Format 'yyyy-MM-ddTHH:mmZ'", "expect_regex": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\dZ", "bad_error": "ambiguous", "note": "Without date.exe on PATH, date turns into Get-Date and -u is ambiguous."},
    {"id": "utc-var", "group": "time", "bad": "UTC=$(date -u +%FT%TZ); echo $UTC", "good": "$utc = Get-Date -AsUTC -Format 'yyyy-MM-ddTHH:mmZ'; $utc", "expect_regex": "\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\dZ", "bad_error": "not recognized"},
    {"id": "time-cmd", "group": "time", "bad": "time node --version", "good": "$sw = [Diagnostics.Stopwatch]::StartNew(); node --version; 'seconds: ' + [math]::Round($sw.Elapsed.TotalSeconds, 1)", "expect": "seconds:", "bad_error": "not recognized", "note": "Measure-Command also works but it hides the command's output."},
    {"id": "env-prefix", "group": "shell", "bad": "FOO=1 node -e 'console.log(process.env.FOO)'", "good": "$env:FOO = '1'; node -e 'console.log(process.env.FOO)'", "expect": "1", "bad_error": "not recognized"},
    {"id": "export", "group": "shell", "bad": "export FOO=1; echo $FOO", "good": "$env:FOO = '1'; $env:FOO", "expect": "1", "bad_error": "not recognized"},
    {"id": "for-loop", "group": "shell", "bad": "for f in a b; do echo $f; done", "good": "foreach ($f in 'a','b') { $f }", "expect": "b", "bad_error": "Missing opening"},
    {"id": "echo-e", "group": "shell", "bad": "echo -e 'a\\nb'", "good": "\"a`nb\"", "expect": "b", "bad_error": "ambiguous"},
    {"id": "dev-null", "group": "shell", "bad": "node -e 'process.exit(3)' >/dev/null 2>&1; echo $LASTEXITCODE", "good": "node -e 'process.exit(3)' *> $null; $LASTEXITCODE", "expect": "3", "bad_error": "dev", "note": "There is no /dev/null. Use $null. For stderr only: 2>$null."},
    {"id": "heredoc", "group": "shell", "bad": "cat <<EOF\nhi\nEOF", "good": "@'\nhi\n'@", "expect": "hi", "bad_error": "Missing file specification", "note": "To write a file use the Write tool."},
    {"id": "python3", "group": "shell", "bad": "python3 --version", "good": "python --version", "expect": "Python 3", "bad_error": "not recognized"},
    {"id": "seq", "group": "shell", "bad": "seq 1 3", "good": "1..3", "expect": "3", "bad_error": "not recognized"},
    {"id": "xargs", "group": "shell", "bad": "Get-ChildItem sub -Name | xargs echo", "good": "Get-ChildItem sub -Name | ForEach-Object { \"file: $_\" }", "expect": "file: a.md", "bad_error": "not recognized"},
    {"id": "and-after-statement", "group": "shell", "bad": "foreach ($f in 'a','b') { $f } && echo after", "good": "foreach ($f in 'a','b') { $f }; if ($?) { 'after' }", "expect": "after", "bad_error": "Unexpected token '&&'", "note": "&& and || work between two pipelines in pwsh 7, never after foreach, if, while or other statements."},
    {"id": "powershell-5", "group": "shell", "bad": "powershell -NoProfile -Command \"Get-Date -AsUTC\"", "good": "pwsh -NoProfile -Command \"Get-Date -AsUTC\"", "expect_regex": "\\d{4}", "bad_error": "AsUTC", "note": "powershell is Windows PowerShell 5.1 (no && or ||, no -AsUTC, UTF-16 on >). Always write pwsh."},
    {"id": "exe-with-space", "group": "shell", "bad": ".\\my tools\\hello.cmd", "good": "& '.\\my tools\\hello.cmd'", "expect": "hello from tools", "bad_error": "not recognized", "note": "A path with a space needs quotes and the call operator &."},
    {"id": "colon-in-string", "group": "quoting", "bad": "$name = 'x'; \"$name: done\"", "good": "$name = 'x'; \"${name}: done\"", "expect": "x: done", "bad_error": "Variable reference is not valid"},
    {"id": "dollar-in-string", "group": "quoting", "bad": "\"price $450 now\"", "good": "'price $450 now'", "expect": "price $450 now", "bad_silent": true, "note": "Inside double quotes $450 is a variable, so it prints nothing. Single quotes keep every character."},
    {"id": "member-in-string", "group": "quoting", "bad": "$o = [pscustomobject]@{a=1}; \"v=$o.a\"", "good": "$o = [pscustomobject]@{a=1}; \"v=$($o.a)\"", "expect": "v=1", "bad_silent": true},
    {"id": "node-e-quotes", "group": "quoting", "bad": "node -e \"console.log(\\\"hi\\\")\"", "good": "node -e 'console.log(\"hi\")'", "expect": "hi", "bad_error": "SyntaxError", "note": "A backslash does not escape a quote in pwsh. Put the script in single quotes, or write it to a .mjs file with the Write tool."},
    {"id": "nested-pwsh", "group": "quoting", "bad": "pwsh -NoProfile -Command \"$x = 5; Write-Output $x\"", "good": "pwsh -NoProfile -Command '$x = 5; Write-Output $x'", "expect": "5", "bad_error": "not recognized", "note": "The outer pwsh fills in $x before the inner one starts. Single quotes stop that."},
    {"id": "here-string-header", "group": "quoting", "bad": "Set-Content -LiteralPath h1.txt -Value @'# Title\nbody\n'@; Get-Content h1.txt", "good": "Set-Content -LiteralPath h1.txt -Value @'\n# Title\nbody\n'@; Get-Content h1.txt", "expect": "# Title", "bad_error": "No characters are allowed", "note": "@' must end its line, and '@ must start its line."},
    {"id": "wildcard-path", "group": "paths", "bad": "Get-Content -Path 'sub/[x]/g.txt'", "good": "Get-Content -LiteralPath 'sub/[x]/g.txt'", "expect": "hi", "bad_error": "does not exist", "note": "-Path treats [ ] * ? as wildcards. Use -LiteralPath for any name you did not make yourself."},
    {"id": "git-bash-path", "group": "paths", "bad": "Get-Content /c/Windows/win.ini -TotalCount 1", "good": "Get-Content C:/Windows/win.ini -TotalCount 1", "expect_regex": "^;", "bad_error": "Cannot find path", "note": "/c/Users style paths are Git Bash only. pwsh wants C:/Users or C:\\Users."},
    {"id": "native-glob", "group": "paths", "bad": "rg -n TODO sub/*.md", "good": "rg -n TODO sub -g '*.md'", "expect": "a.md", "bad_error": "os error 123", "note": "pwsh does not expand * for programs. Cmdlets expand it, programs do not."},
    {"id": "exit-code", "group": "exit", "good": "node -e 'process.exit(2)'; \"exit=$LASTEXITCODE\"", "expect": "exit=2", "note": "$LASTEXITCODE is the exit code of the last program. $? is only True or False."},
    {"id": "exit-code-pipe", "group": "exit", "good": "node -e 'process.exit(2)' 2>&1 | Select-Object -Last 3; \"exit=$LASTEXITCODE\"", "expect": "exit=2", "note": "Piping a program into a cmdlet keeps its exit code."},
    {"id": "native-no-stop", "group": "exit", "good": "$ErrorActionPreference = 'Stop'; node -e 'process.exit(1)'; 'still ran'", "expect": "still ran", "note": "A failing program never stops the script, even with ErrorActionPreference Stop. Test $LASTEXITCODE yourself."},
    {"id": "curl-exe", "group": "exit", "good": "(Get-Command curl.exe).Source", "expect": "curl.exe", "note": "Write curl.exe. In Windows PowerShell 5.1 plain curl is Invoke-WebRequest with other flags."}
  ]
}
