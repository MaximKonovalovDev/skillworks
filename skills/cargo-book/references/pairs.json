    {
      "good": {
        "fixture": {
          "Cargo.toml": "[workspace]\nmembers = [\"app\", \"helper\", \"shared\"]\nresolver = \"2\"\n",
          "app/Cargo.toml": "[package]\nname = \"app\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nshared = { path = \"../shared\", features = [\"alpha\"] }\n",
          "app/src/main.rs": "fn main() {\n    println!(\"{}\", shared::who());\n}\n",
          "helper/Cargo.toml": "[package]\nname = \"helper\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\nshared = { path = \"../shared\", features = [\"beta\"] }\n",
          "helper/src/main.rs": "fn main() {\n    println!(\"{}\", shared::who());\n}\n",
          "shared/Cargo.toml": "[package]\nname = \"shared\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n\n[features]\nalpha = []\nbeta = []\n",
          "shared/src/lib.rs": "#[cfg(feature = \"alpha\")]\npub fn who() -> &'static str {\n    \"alpha\"\n}\n#[cfg(all(feature = \"beta\", not(feature = \"alpha\")))]\npub fn who() -> &'static str {\n    \"beta\"\n}\n#[cfg(not(any(feature = \"alpha\", feature = \"beta\")))]\npub fn who() -> &'static str {\n    \"plain\"\n}\n"
        },
        "steps": [
          {
            "argv": [
              "cargo",
              "build",
              "--workspace"
