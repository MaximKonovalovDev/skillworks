      "group": "profile",
      "id": "cb-p04",
      "title": "release profile and its artifact directory"
    },
    {
      "bad": {
        "fixture": {
          "Cargo.toml": "[workspace]\nmembers = [\"ghost\"]\nresolver = \"2\"\n"
        },
        "steps": [
          {
            "argv": [
              "cargo",
              "build",
              "--workspace"
            ],
            "expect": [
              "failed to read",
              "ghost"
            ],
            "expect_exit": 101
          }
        ]
      },
      "good": {
        "fixture": {
          "Cargo.toml": "[workspace]\nmembers = [\"a\", \"b\"]\nresolver = \"2\"\n"
        },
        "steps": [
          {
            "write": {
              "a/Cargo.toml": "[package]\nname = \"a\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n",
              "a/src/main.rs": "fn main() {\n    println!(\"a\");\n}\n",
              "b/Cargo.toml": "[package]\nname = \"b\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[dependencies]\n",
              "b/src/main.rs": "fn main() {\n    println!(\"b\");\n}\n"
            }
          },
          {
            "argv": [
              "cargo",
              "build",
              "--workspace"
            ],
            "expect": [
              "Compiling a",
              "Compiling b",
              "Finished"
            ],
            "expect_exit": 0
          },
          {
            "assert_exists": [
              "Cargo.lock"
            ]
          }
        ]
      },
      "group": "workspace",
      "id": "cb-p05",
      "title": "virtual workspace builds every member"
    },
    {
      "bad": {
