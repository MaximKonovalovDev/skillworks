              "feat"
            ],
            "expect": [
              "Creating binary"
            ],
            "expect_exit": 0
          },
          {
            "write": {
              "feat/Cargo.toml": "[package]\nname = \"feat\"\nversion = \"0.1.0\"\nedition = \"2024\"\n\n[features]\nextra = []\n",
              "feat/src/main.rs": "fn main() {\n    #[cfg(feature = \"extra\")]\n    println!(\"extra on\");\n    #[cfg(not(feature = \"extra\"))]\n    println!(\"basic\");\n}\n"
            }
          },
