{
  "about": "Every pair runs with real cargo 1.97.1 in its own fresh scratch directory (see scripts/cargo_book.py). good prints the output shown; bad fails with the real cargo error named. All fixtures are dependency-free and run with CARGO_NET_OFFLINE=1.",
  "pairs": [
    {
      "bad": {
        "fixture": {
          "empty/.keep": ""
        },
        "steps": [
          {
            "argv": [
              "cargo",
              "run"
            ],
            "cwd": "empty",
            "expect": [
              "could not find",
              "Cargo.toml"
            ],
            "expect_exit": 101
          }
        ]
      },
      "good": {
        "steps": [
          {
            "argv": [
              "cargo",
              "new",
              "hello_world"
            ],
            "expect": [
              "Creating binary"
            ],
            "expect_exit": 0
          },
          {
            "argv": [
              "cargo",
              "run"
            ],
            "cwd": "hello_world",
            "expect": [
              "Hello, world!",
              "Finished"
            ],
            "expect_exit": 0
          }
        ]
      },
      "group": "start",
      "id": "cb-p01",
      "title": "new binary package and first run"
    },
    {
      "bad": {
        "steps": [
          {
            "argv": [
              "cargo",
              "new",
              "hello_world"
            ],
            "expect": [
              "Creating binary"
            ],
            "expect_exit": 0
          },
          {
            "argv": [
              "cargo",
              "build"
            ],
            "cwd": "hello_world",
            "expect": [
              "Finished"
            ],
            "expect_exit": 0
          },
          {
            "argv": [
              "cargo",
              "update",
              "nosuch"
            ],
            "cwd": "hello_world",
            "expect": [
              "did not match any packages"
            ],
            "expect_exit": 101
          }
        ]
      },
      "good": {
        "steps": [
          {
            "argv": [
              "cargo",
              "new",
              "hello_world"
            ],
            "expect": [
              "Creating binary"
            ],
            "expect_exit": 0
          },
          {
            "argv": [
              "cargo",
              "build"
            ],
            "cwd": "hello_world",
            "expect": [
              "Compiling hello_world",
              "Finished"
            ],
            "expect_exit": 0
          },
          {
            "assert_contains": {
              "file": "hello_world/Cargo.lock",
              "fragments": [
                "name = \"hello_world\"",
                "version = \"0.1.0\""
              ]
            }
          },
          {
            "argv": [
              "cargo",
              "update"
            ],
            "cwd": "hello_world",
            "expect": [
              "Locking 0 packages"
            ],
            "expect_exit": 0
          }
        ]
      },
      "group": "start",
      "id": "cb-p02",
      "title": "lockfile pins the exact revision"
    },
    {
      "bad": {
        "steps": [
          {
            "argv": [
              "cargo",
              "new",
              "--lib",
              "mylib"
            ],
            "expect": [
              "Creating library"
            ],
            "expect_exit": 0
          },
          {
            "write": {
              "mylib/src/lib.rs": "fn add(a: i32, b: i32) -> i32 { a + b }\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn test_add() {\n        assert_eq!(add(2, 2), 5);\n    }\n}\n"
            }
          },
          {
            "argv": [
              "cargo",
              "test"
            ],
            "cwd": "mylib",
            "expect": [
              "FAILED",
              "0 passed; 1 failed"
            ],
            "expect_exit": 101
          }
        ]
      },
      "good": {
        "steps": [
          {
            "argv": [
              "cargo",
              "new",
              "--lib",
              "mylib"
            ],
            "expect": [
              "Creating library"
            ],
            "expect_exit": 0
          },
          {
            "write": {
              "mylib/src/lib.rs": "fn add(a: i32, b: i32) -> i32 { a + b }\n#[cfg(test)]\nmod tests {\n    use super::*;\n    #[test]\n    fn test_add() {\n        assert_eq!(add(2, 2), 4);\n    }\n}\n"
            }
          },
          {
            "argv": [
              "cargo",
              "test"
            ],
            "cwd": "mylib",
            "expect": [
              "1 passed"
            ],
            "expect_exit": 0
          }
        ]
      },
      "group": "fix",
      "id": "cb-p03",
      "title": "failing assert then the one-line fix"
    },
    {
      "bad": {
        "steps": [
