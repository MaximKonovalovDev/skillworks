// skillworks loop (center/loopkit.mjs 2026-10-02): free Muse through the retry proxy, the lead is the only primary.
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "shell": "pwsh",
  // Depth 2 (Maxim 2026-10-04): a helper may send its own helpers (up to 10 at once,
  // the keeper's cap); those cannot send more.
  "subagent_depth": 2,
  "instructions": [
    "AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 550000,
    "tail_turns": 5,
    "preserve_recent_tokens": 8000
  },
  "tool_output": { "max_lines": 250, "max_bytes": 25000 },
  // 2026-10-03 (Maxim): only these providers: Muse 1.3 Go + free, Mimo, 9Router Opus 5.5 + Rgemini.
  "enabled_providers": ["opencode-go","zen-proxy-muse","zen-proxy-mimo","9router"],
  "provider": {
    "opencode-go": {
      "whitelist": [
        "muse-spark-1.3-contributor"
      ],
      "models": {
        "muse-spark-1.3-contributor": {
          "id": "muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor (Go, paid)",
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 128000
          }
        }
      }
    },
    "zen-proxy-muse": {
      "name": "Muse Spark 1.3 free via local retry proxy",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://127.0.0.1:13579/v1",
        "apiKey": "zen-proxy",
        "timeout": 3600000,
        "chunkTimeout": 3600000
      },
      "whitelist": [
        "muse-spark-1.3-contributor-free"
      ],
      "models": {
        "muse-spark-1.3-contributor-free": {
          "id": "muse-spark-1.3-contributor-free",
          "name": "Muse Spark 1.3 Contributor Free (retry proxy)",
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "textVerbosity": "low",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        }
      }
    },
    "zen-proxy-mimo": {
      "name": "Mimo 2.6 Flash free via local retry proxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:13579/v1",
        "apiKey": "zen-proxy",
        "timeout": 3600000,
        "chunkTimeout": 3600000
      },
      "whitelist": [
        "mimo-v2.6-flash-free"
      ],
      "models": {
        "mimo-v2.6-flash-free": {
          "id": "mimo-v2.6-flash-free",
          "name": "Mimo 2.6 Flash Free (retry proxy)",
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 131072
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "9router": {
      "name": "9Router local gateway",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20129/v1",
        "apiKey": "9router-local-key",
        "timeout": 3600000,
        "chunkTimeout": 3600000
      },
      "whitelist": [
        "opus-5.5",
        "Rgemini"
      ],
      "models": {
        "opus-5.5": {
          "id": "cc/claude-opus-5-5",
          "name": "Claude Opus 5.5 via 9Router (direct)",
          "limit": {
            "context": 1000000,
            "input": 870000,
            "output": 128000
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "Rgemini": {
          "id": "Rgemini",
          "name": "Rgemini combo via 9Router (Opus 5.5)",
          "limit": {
            "context": 1000000,
            "input": 870000,
            "output": 128000
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    }
  },
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": false,
      "timeout": 30000
    },
    "github": {
      "type": "local",
      "command": [
        "node",
        "C:/Users/me/Desktop/center/mcp/github-mcp.mjs"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "arxiv": {
      "type": "local",
      "command": [
        "C:/Users/me/.config/opencode/mcp/arxiv-venv/Scripts/arxiv-mcp-server.exe",
        "--storage-path",
        "C:/Users/me/.config/opencode/mcp/arxiv-papers"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "*": "allow",
    "doom_loop": "allow",
    "question": "deny",
    "github_*": "deny",
    "arxiv_*": "deny",
    "deepwiki_*": "deny",
    "arsenal_*": "deny",
    "web-search_*": "deny"
  }
}
