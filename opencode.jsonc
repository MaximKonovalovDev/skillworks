// skillworks loop (center/loopkit.mjs 2026-10-02): free Muse through the retry proxy, the lead is the only primary.
{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "shell": "pwsh",
  "instructions": [
    "AGENTS.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 600000,
    "tail_turns": 5,
    "preserve_recent_tokens": 8000
  },
  "provider": {
    "zen-proxy-muse": {
      "name": "Muse Spark 1.3 Contributor Free via local retry proxy",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "http://127.0.0.1:13579/v1",
        "apiKey": "zen-proxy",
        "timeout": 3600000,
        "chunkTimeout": 3600000
      },
      "whitelist": [
        "muse-spark-1.3-contributor-free",
        "muse-spark-1.4-contributor-free"
      ],
      "models": {
        "muse-spark-1.3-contributor-free": {
          "id": "muse-spark-1.3-contributor-free",
          "name": "Muse Spark 1.3 Contributor Free (Zen, proxied, 429 resets IP)",
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "textVerbosity": "low",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        },
        "muse-spark-1.4-contributor-free": {
          "id": "muse-spark-1.4-contributor-free",
          "name": "Muse Spark 1.4 Contributor Free (Zen, proxied, 429 resets IP)",
          "limit": {
            "context": 1048576,
            "input": 900000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
            "reasoningSummary": "auto",
            "textVerbosity": "low",
            "include": [
              "reasoning.encrypted_content"
            ]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "medium": {
              "reasoningEffort": "medium",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "high": {
              "reasoningEffort": "high",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            },
            "xhigh": {
              "reasoningEffort": "xhigh",
              "reasoningSummary": "auto",
              "textVerbosity": "low",
              "include": [
                "reasoning.encrypted_content"
              ]
            }
          }
        }
      }
    },
    "9router": {
      "name": "9Router local gateway (Gemini free via Vertex/Kiro/OpenCode)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:20129/v1",
        "apiKey": "9router-local-key",
        "timeout": 3600000,
        "chunkTimeout": 3600000
      },
      "models": {
        "gemini-free": {
          "id": "vertex/gemini-3.1-flash",
          "name": "Gemini free via 9Router (Vertex)",
          "limit": {
            "context": 1000000,
            "input": 900000,
            "output": 64000
          }
        },
        "free-forever": {
          "id": "free-forever",
          "name": "9Router free-forever combo (kr/oc/vertex)",
          "limit": {
            "context": 200000,
            "output": 32000
          }
        },
        "claude-via-router": {
          "id": "cc/claude-sonnet-4-6",
          "name": "Claude via 9Router (add account in dashboard)",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        },
        "Rgemini": {
          "id": "Rgemini",
          "name": "Rgemini combo via 9Router (you create combo in dashboard)",
          "limit": {
            "context": 300000,
            "output": 64000
          }
        }
      }
    }
  },
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true,
      "timeout": 30000
    },
    "github": {
      "type": "local",
      "command": [
        "node",
        "C:/Users/me/Desktop/center/mcp/github-mcp.mjs"
      ],
      "enabled": true,
      "timeout": 20000
    },
    "arxiv": {
      "type": "local",
      "command": [
        "C:/Users/me/.config/opencode/mcp/arxiv-venv/Scripts/arxiv-mcp-server.exe",
        "--storage-path",
        "C:/Users/me/.config/opencode/mcp/arxiv-papers"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "*": "allow",
    "doom_loop": "allow",
    "question": "deny",
    "github_*": "deny",
    "arxiv_*": "deny",
    "deepwiki_*": "deny"
  }
}
